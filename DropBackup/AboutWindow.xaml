<Window x:Class="DropBackup.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DropBackup.Properties"
        Title="{x:Static res:Resources.AboutWindow_Title}" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Yu Gothic UI" FontSize="13">
    <StackPanel>
        <Border Padding="0,28,0,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF1A5FC0" Offset="0"/>
                    <GradientStop Color="#FF0D3A8A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <Image Source="Assets/icon.ico" Width="72" Height="72"
                       HorizontalAlignment="Center" Margin="0,0,0,14"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="tbAppName" Foreground="White"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="tbVersion" Foreground="#BBDEFF"
                           FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="28,20,28,24">
            <TextBlock Text="{x:Static res:Resources.About_Description}"
                       TextAlignment="Center" Foreground="#333333" TextWrapping="Wrap"
                       LineHeight="20" Margin="0,0,0,18"/>
            <Separator Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="GitHub: " Foreground="Gray" FontSize="12"/>
                <TextBlock FontSize="12">
                    <Hyperlink x:Name="lnkGitHub" RequestNavigate="lnkGitHub_RequestNavigate"
                               NavigateUri="https://github.com/noriseko/dropbackup">
                        github.com/noriseko/dropbackup
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <TextBlock x:Name="tbCopyright" Foreground="Gray" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,4,0,20"/>
            <Button Width="100" Height="30" HorizontalAlignment="Center"
                    IsDefault="True" IsCancel="True" Click="btnClose_Click">
                <Button.Content><TextBlock Text="{x:Static res:Resources.Btn_Close}"/></Button.Content>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#1E6FCC"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A5FB0"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#144E9A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
