<Window x:Class="DropBackup.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:DropBackup"
		xmlns:res="clr-namespace:DropBackup.Properties"
		mc:Ignorable="d"
		Title="{x:Static res:Resources.MainWindow_Title}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
		WindowStartupLocation="CenterScreen"
		FontFamily="Yu Gothic UI" FontSize="13"
		Loaded="Window_Loaded">

	<Window.Resources>
		<!-- Section header style -->
		<Style x:Key="SectionHeader" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#0078D4"/>
			<Setter Property="Margin" Value="0,14,0,4"/>
		</Style>
		<!-- Sub text style -->
		<Style x:Key="SubText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#666666"/>
		</Style>
		<!-- Normal button style -->
		<Style x:Key="NormalButton" TargetType="Button">
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="12,0"/>
		</Style>
		<!-- Primary button style (OK) -->
		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="Background" Value="#0078D4"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#0078D4"/>
		</Style>
		<!-- Link-style button -->
		<Style x:Key="LinkButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Foreground" Value="#0078D4"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<TextBlock Text="{TemplateBinding Content}"
								   Foreground="{TemplateBinding Foreground}"
								   FontSize="{TemplateBinding FontSize}"
								   VerticalAlignment="Center"
								   TextDecorations="Underline"/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<DockPanel>

		<!-- ========== Tab control ========== -->
		<TabControl x:Name="tabControl" DockPanel.Dock="Top" Margin="0">

			<!-- ======== Backup tab ======== -->
			<TabItem Header="{x:Static res:Resources.Tab_Backup}">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="20,12,20,16">

						<!-- Date/Time Format -->
						<TextBlock Text="{x:Static res:Resources.Section_DateFormat}" Style="{StaticResource SectionHeader}"/>
						<Separator Margin="0,0,0,8" Background="#E0E0E0"/>
						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBox x:Name="tbFormat" Grid.Column="0" Height="28" Padding="6,0"
									 VerticalContentAlignment="Center"
									 TextChanged="tbFormat_TextChanged"/>
							<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"
										VerticalAlignment="Center">
								<TextBlock Text="{x:Static res:Resources.Label_Preview}" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
								<TextBlock x:Name="tbPreview" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
							</StackPanel>
						</Grid>
						<TextBlock Style="{StaticResource SubText}" Margin="0,0,0,0"
								   Text="{x:Static res:Resources.Label_FormatHint}"/>

						<!-- Timestamp Position -->
						<TextBlock Text="{x:Static res:Resources.Section_AppendPos}" Style="{StaticResource SectionHeader}"/>
						<Separator Margin="0,0,0,8" Background="#E0E0E0"/>
						<RadioButton x:Name="rbPosBefore" Margin="0,0,0,6" GroupName="AppendPos"
									 Content="{x:Static res:Resources.RadioBtn_PosBefore}"/>
						<RadioButton x:Name="rbPosAfter" GroupName="AppendPos"
									 Content="{x:Static res:Resources.RadioBtn_PosAfter}"/>

						<!-- When file already exists -->
						<TextBlock Text="{x:Static res:Resources.Section_DuplicateHandling}" Style="{StaticResource SectionHeader}"/>
						<Separator Margin="0,0,0,8" Background="#E0E0E0"/>
						<RadioButton x:Name="rbOpeRename"   Margin="0,0,0,6" GroupName="OpeWhenExists" Content="{x:Static res:Resources.RadioBtn_OpeRename}"/>
						<RadioButton x:Name="rbOpeOverride" Margin="0,0,0,6" GroupName="OpeWhenExists" Content="{x:Static res:Resources.RadioBtn_OpeOverride}"/>
						<RadioButton x:Name="rbOpeDelete"                    GroupName="OpeWhenExists" Content="{x:Static res:Resources.RadioBtn_OpeDelete}"/>

						<!-- Backup Destination -->
						<TextBlock Text="{x:Static res:Resources.Section_Destination}" Style="{StaticResource SectionHeader}"/>
						<Separator Margin="0,0,0,8" Background="#E0E0E0"/>
						<RadioButton x:Name="rbDestSameDir" Margin="0,0,0,6" GroupName="DestDir"
									 Content="{x:Static res:Resources.RadioBtn_DestSameDir}"
									 Checked="rbDest_Changed"/>
						<RadioButton x:Name="rbDestCustomDir" Margin="0,0,0,8" GroupName="DestDir"
									 Content="{x:Static res:Resources.RadioBtn_DestCustomDir}"
									 Checked="rbDest_Changed"/>
						<Grid x:Name="pnlDestDir" IsEnabled="False" Margin="16,0,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBox x:Name="tbDestDir" Grid.Column="0" Height="28" Padding="6,0"
									 VerticalContentAlignment="Center" Margin="0,0,6,0"/>
							<Button x:Name="btnBrowseDest" Grid.Column="1"
									Content="{x:Static res:Resources.Btn_Browse}"
									Style="{StaticResource NormalButton}" Width="70"
									Click="btnBrowseDest_Click"/>
							<Button x:Name="btnOpenDestDir" Grid.Column="2"
									Content="{x:Static res:Resources.Btn_Open}"
									Style="{StaticResource NormalButton}" Width="50" Margin="6,0,0,0"
									Click="btnOpenDestDir_Click"/>
						</Grid>

						<!-- Other -->
						<TextBlock Text="{x:Static res:Resources.Section_Other}" Style="{StaticResource SectionHeader}"/>
						<Separator Margin="0,0,0,8" Background="#E0E0E0"/>
						<CheckBox x:Name="cbExcludeSymLinks" Content="{x:Static res:Resources.CheckBox_ExcludeSymLinks}"/>

					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- ======== File Filter tab ======== -->
			<TabItem Header="{x:Static res:Resources.Tab_Filter}">
				<StackPanel Margin="20,12,20,16">

					<TextBlock Text="{x:Static res:Resources.Section_ExcludePatterns}" Style="{StaticResource SectionHeader}"/>
					<Separator Margin="0,0,0,8" Background="#E0E0E0"/>
					<TextBlock TextWrapping="Wrap" Style="{StaticResource SubText}" Margin="0,0,0,10"
							   Text="{x:Static res:Resources.Label_FilterHint}"/>

					<!-- Input row -->
					<Grid Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBox x:Name="tbFilterPattern" Grid.Column="0" Height="28" Padding="6,0"
								 VerticalContentAlignment="Center" Margin="0,0,6,0"
								 KeyDown="tbFilterPattern_KeyDown"/>
						<Button x:Name="btnFilterAdd" Grid.Column="1"
								Content="{x:Static res:Resources.Btn_Add}"
								Style="{StaticResource NormalButton}" Width="70"
								Click="btnFilterAdd_Click"/>
					</Grid>

					<!-- Pattern list -->
					<ListBox x:Name="lbFilters" Height="160" Margin="0,0,0,8"
							 SelectionMode="Extended" FontFamily="Consolas" FontSize="12"/>

					<!-- Delete button -->
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button x:Name="btnFilterDelete"
								Content="{x:Static res:Resources.Btn_DeleteSelected}"
								Style="{StaticResource NormalButton}" Width="130"
								Click="btnFilterDelete_Click"/>
					</StackPanel>
				</StackPanel>
			</TabItem>

			<!-- ======== General tab ======== -->
			<TabItem Header="{x:Static res:Resources.Tab_General}">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="20,12,20,16">

						<!-- Log -->
						<TextBlock Text="{x:Static res:Resources.Section_Log}" Style="{StaticResource SectionHeader}"/>
						<Separator Margin="0,0,0,8" Background="#E0E0E0"/>
						<CheckBox x:Name="cbEnableLog" Content="{x:Static res:Resources.CheckBox_EnableLog}"
								  Margin="0,0,0,10"
								  Checked="cbEnableLog_Changed" Unchecked="cbEnableLog_Changed"/>

						<StackPanel x:Name="pnlLogOptions">
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="{x:Static res:Resources.Label_LogLocation}" VerticalAlignment="Center" Margin="0,0,8,0"/>
								<TextBox x:Name="tbLogDirectory" Grid.Column="1" Height="28" Padding="6,0"
										 VerticalContentAlignment="Center" Margin="0,0,6,0"/>
								<Button x:Name="btnBrowse" Grid.Column="2"
										Content="{x:Static res:Resources.Btn_Browse}"
										Style="{StaticResource NormalButton}" Width="70"
										Click="btnBrowse_Click"/>
								<Button x:Name="btnOpenLogDir" Grid.Column="3"
										Content="{x:Static res:Resources.Btn_Open}"
										Style="{StaticResource NormalButton}" Width="50" Margin="6,0,0,0"
										Click="btnOpenLogDir_Click"/>
							</Grid>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="{x:Static res:Resources.Label_RetentionDays}" VerticalAlignment="Center" Margin="0,0,8,0"/>
								<TextBox x:Name="tbRetentionDays" Width="60" Height="28" Padding="6,0"
										 VerticalContentAlignment="Center" Margin="0,0,6,0"/>
								<TextBlock Text="{x:Static res:Resources.Label_Days}" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
							</StackPanel>
						</StackPanel>

						<!-- Notification -->
						<TextBlock Text="{x:Static res:Resources.Section_Notification}" Style="{StaticResource SectionHeader}"/>
						<Separator Margin="0,0,0,8" Background="#E0E0E0"/>
						<CheckBox x:Name="cbUseToast"
								  Content="{x:Static res:Resources.CheckBox_UseToast}"/>

								</StackPanel>
							</ScrollViewer>
						</TabItem>

		</TabControl>

		<!-- ========== Footer ========== -->
		<Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
				Padding="16,10">
			<Grid>
				<Button x:Name="btnAbout" Content="About" Style="{StaticResource LinkButton}"
						HorizontalAlignment="Left" Click="btnAbout_Click"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button x:Name="btnCancel" Content="{x:Static res:Resources.Btn_Cancel}"
							Style="{StaticResource NormalButton}" Width="90" Margin="0,0,8,0"
							IsCancel="True" Click="btnCancel_Click"/>
					<Button x:Name="btnOK" Content="{x:Static res:Resources.Btn_OK}"
							Style="{StaticResource PrimaryButton}" Width="90"
							IsDefault="True" Click="btnOK_Click"/>
				</StackPanel>
			</Grid>
		</Border>

	</DockPanel>
</Window>