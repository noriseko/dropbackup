<Window x:Class="DropBackup.NotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DropBackup.Properties"
        Title="{x:Static res:Resources.NotifyWindow_Title}"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="CountStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#888888"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <StackPanel>
        <!-- Branded header -->
        <Border Padding="0,20,0,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF1A5FC0" Offset="0"/>
                    <GradientStop Color="#FF0D3A8A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="Assets/icon.ico" Width="36" Height="36"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="DropBackup" Foreground="White"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Summary counters -->
        <Grid Margin="24,20,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Success -->
            <StackPanel Grid.Column="0">
                <Border CornerRadius="8" Background="#F0FFF4" Padding="8,10">
                    <StackPanel>
                        <TextBlock x:Name="tbSuccessCount" Style="{StaticResource CountStyle}" Foreground="#1E7E34"/>
                        <TextBlock x:Name="tbSuccessLabel" Style="{StaticResource LabelStyle}" Foreground="#28A745"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Failed -->
            <StackPanel Grid.Column="1" Margin="8,0">
                <Border CornerRadius="8" Background="#FFF5F5" Padding="8,10">
                    <StackPanel>
                        <TextBlock x:Name="tbFailedCount" Style="{StaticResource CountStyle}" Foreground="#C0392B"/>
                        <TextBlock x:Name="tbFailedLabel" Style="{StaticResource LabelStyle}" Foreground="#E74C3C"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Skipped -->
            <StackPanel Grid.Column="2">
                <Border CornerRadius="8" Background="#F8F9FA" Padding="8,10">
                    <StackPanel>
                        <TextBlock x:Name="tbSkippedCount" Style="{StaticResource CountStyle}" Foreground="#555555"/>
                        <TextBlock x:Name="tbSkippedLabel" Style="{StaticResource LabelStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Detail sections (symlinks / filter) -->
        <StackPanel x:Name="pnlDetails" Margin="24,12,24,0" Visibility="Collapsed">
            <Separator Margin="0,0,0,10"/>

            <StackPanel x:Name="pnlSymLinks" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock x:Name="tbSymLinksHeader" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="#FFFBEC" CornerRadius="4" Padding="8,6">
                    <TextBlock x:Name="tbSymLinks" FontSize="11" Foreground="#555"
                               TextWrapping="Wrap" FontFamily="Consolas"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="pnlFilter" Visibility="Collapsed">
                <TextBlock x:Name="tbFilterHeader" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="#F3F0FF" CornerRadius="4" Padding="8,6">
                    <TextBlock x:Name="tbFilter" FontSize="11" Foreground="#555"
                               TextWrapping="Wrap" FontFamily="Consolas"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Close button -->
        <Button x:Name="btnClose" Width="100" Height="32"
                HorizontalAlignment="Center" Margin="0,20,0,24"
                IsDefault="True" IsCancel="True" Click="btnClose_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#1E6FCC"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A5FB0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#144E9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</Window>
